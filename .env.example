# Plantilla de Variables de Entorno - ConectaTec (Caso 03 Grupo 3)
# COPIA ESTE ARCHIVO A .env Y COLOCA TUS CLAVES REALES.
# NUNCA SUBAS EL ARCHIVO .env A GIT (ESTA EN .gitignore).

# Clave de API de Google Gemini (Modelo Primario: gemini-1.5-flash)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Clave de API de Groq Cloud (Modelo de Respaldo / Failover: llama-3.3-70b-versatile)
GROQ_API_KEY=tu_clave_de_groq_aqui

# Proveedor LLM Activo por Defecto: "gemini" o "groq"
# Principio de Arquitectura: Cambiar de proveedor NO requiere tocar ningún endpoint de FastAPI
PROVEEDOR_LLM_ACTIVO=gemini

# Configuracion de Entorno y Servidor

ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Base de Datos SQLite Local
DATABASE_URL=sqlite:///./data/conectatec.db

# Autenticación y Control de Acceso (Cero secretos en Git - OWASP LLM02)
# Generar una clave secreta para firma criptográfica JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=cambiar_por_cadena_secreta_aleatoria_produccion

# Contraseña inicial del administrador TIC (nunca subir contraseñas a Git)
ADMIN_PASSWORD=cambiar_por_contrasena_segura_produccion
